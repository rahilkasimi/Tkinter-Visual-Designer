": ["Segoe UI", 16], "fg": "#f6f6f6", "bg": "#3b3b3b", "relief": "flat", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 1).\nTriggered by: command\nAccess widget instance via: self._elem_1\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 16}, {"elem_type": "Button", "x": 10, "y": 361, "canvas_w": 100, "canvas_h": 53.0, "props": {"text": 1, "font": ["Segoe UI", 16], "fg": "#f6f6f6", "bg": "#3b3b3b", "relief": "flat", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 1).\nTriggered by: command\nAccess widget instance via: self._elem_1\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 17}, {"elem_type": "Button", "x": 115, "y": 361, "canvas_w": 100, "canvas_h": 53.0, "props": {"text": 2, "font": ["Segoe UI", 16], "fg": "#f6f6f6", "bg": "#3b3b3b", "relief": "flat", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 1).\nTriggered by: command\nAccess widget instance via: self._elem_1\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 18}, {"elem_type": "Button", "x": 220, "y": 361, "canvas_w": 100, "canvas_h": 53.0, "props": {"text": 3, "font": ["Segoe UI", 16], "fg": "#f6f6f6", "bg": "#3b3b3b", "relief": "flat", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 1).\nTriggered by: command\nAccess widget instance via: self._elem_1\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 19}, {"elem_type": "Button", "x": 326, "y": 361, "canvas_w": 100, "canvas_h": 53.0, "props": {"text": "+", "font": ["Segoe UI", 16], "fg": "#f6f6f6", "bg": "#3b3b3b", "relief": "flat", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 1).\nTriggered by: command\nAccess widget instance via: self._elem_1\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 20}, {"elem_type": "Label", "x": 0, "y": 44, "canvas_w": 440, "canvas_h": 78.0, "props": {"text": "", "font": ["Segoe UI", 33], "fg": "#f6f6f6", "bg": "#202020", "relief": "flat", "justify": "center"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 21}, {"elem_type": "Label", "x": 0, "y": 5, "canvas_w": 440, "canvas_h": 39.0, "props": {"text": "Standard Calculator", "font": ["Segoe UI Black", 20], "fg": "#f6f6f6", "bg": "#3b3b3b", "relief": "flat", "justify": "center"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 22}, {"elem_type": "Button", "x": 10, "y": 419, "canvas_w": 100, "canvas_h": 53.0, "props": {"text": "+/-", "font": ["Segoe UI", 16], "fg": "#f6f6f6", "bg": "#3b3b3b", "relief": "flat", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 1).\nTriggered by: command\nAccess widget instance via: self._elem_1\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 23}, {"elem_type": "Button", "x": 115, "y": 419, "canvas_w": 100, "canvas_h": 53.0, "props": {"text": 0, "font": ["Segoe UI", 16], "fg": "#f6f6f6", "bg": "#3b3b3b", "relief": "flat", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 1).\nTriggered by: command\nAccess widget instance via: self._elem_1\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 24}, {"elem_type": "Button", "x": 220, "y": 419, "canvas_w": 100, "canvas_h": 53.0, "props": {"text": ".", "font": ["Segoe UI", 16], "fg": "#f6f6f6", "bg": "#3b3b3b", "relief": "flat", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 1).\nTriggered by: command\nAccess widget instance via: self._elem_1\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 25}, {"elem_type": "Button", "x": 326, "y": 419, "canvas_w": 100, "canvas_h": 53.0, "props": {"text": "=", "font": ["Segoe UI", 20], "fg": "#202020", "bg": "#F38064", "relief": "flat", "command": ""}, "handler_code": "self._equals()", "parent_id": null, "parent_tab": null, "elem_id": 26}, {"elem_type": "Button", "x": 391, "y": 9, "canvas_w": 30, "canvas_h": 30, "props": {"text": "?", "font": ["Segoe UI", 9, "bold"], "fg": "#FFFFFF", "bg": "#3b3b3b", "command": "", "corner_radius": 0, "border_width": 0}, "handler_code": "\"\"\"Show keyboard shortcuts popup (excluding numeric and operator keys).\"\"\"\npopup = ctk.CTkToplevel(self.root)\npopup.title(\"Keyboard Shortcuts\")\npopup.geometry(\"350x300\")\npopup.resizable(False, False)\npopup.attributes(\"-topmost\", True)\n\nshortcuts_text = \"\"\"Keyboard Shortcuts (excluding numeric and operator keys):\n\nBackspace  - Delete last character\nEscape     - Clear all (C)\nDelete     - Clear entry (CE)\n%          - Percent\nr or R     - Reciprocal (1/x)\ns or S     - Square root (\u221ax)\n^          - Square (x\u00b2)\nn or N     - Toggle sign (+/-)\nEnter or = - Equals\n\"\"\"\n\nlabel = ctk.CTkLabel(popup, text=shortcuts_text, font=('Segoe UI', 14), justify=\"left\", anchor=\"w\")\nlabel.pack(pady=20, padx=20, fill=\"both\", expand=True)\n\nclose_btn = ctk.CTkButton(popup, text=\"Close\", command=popup.destroy, width=100)\nclose_btn.pack(pady=10)\n\npopup.grab_set()\npopup.focus_force()", "parent_id": null, "parent_tab": null, "elem_id": 27}], "next_id": 31, "reusable_ids": [28, 29, 30], "window_title": "My Application", "canvas_w": 440, "canvas_h": 490, "canvas_bg": "#232323", "canvas_imports": "import tkinter as tk\nfrom tkinter import ttk", "full_code": "\"\"\"Generated by Tkinter Visual Designer.\"\"\"\n\nimport tkinter as tk\nfrom tkinter import ttk\nimport customtkinter as ctk\nimport math\n\n\nclass MainApplication:\n    def __init__(self, root):\n        self.root = root\n        root.title(\"My Application\")\n        root.geometry(\"440x490\")\n        root.configure(bg=\"#232323\")\n\n        # Calculator state\n        self.current = \"0\"\n        self.stored = None\n        self.operator = None\n        self.start_new = True\n        self.error = False\n\n        self._elem_1 = ctk.CTkButton(root, text=\"%\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_1, width=100, height=53.0)\n        self._elem_1.place(x=10, y=128)\n        self._elem_2 = ctk.CTkButton(root, text=\"CE\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_2, width=100, height=53.0)\n        self._elem_2.place(x=115, y=128)\n        self._elem_3 = ctk.CTkButton(root, text=\"C\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_3, width=100, height=53.0)\n        self._elem_3.place(x=220, y=128)\n        self._elem_4 = ctk.CTkButton(root, text=\"\\u2b05\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_4, width=100, height=53.0)\n        self._elem_4.place(x=327, y=128)\n        self._elem_5 = ctk.CTkButton(root, text=\"\\u00b9\\u2044\\u2093\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_5, width=100, height=53.0)\n        self._elem_5.place(x=10, y=186)\n        self._elem_6 = ctk.CTkButton(root, text=\"x\\u00b2\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_6, width=100, height=53.0)\n        self._elem_6.place(x=115, y=186)\n        self._elem_7 = ctk.CTkButton(root, text=\"\\u00b2\\u221ax\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_7, width=100, height=53.0)\n        self._elem_7.place(x=220, y=186)\n        self._elem_8 = ctk.CTkButton(root, text=\"\\u00f7\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_8, width=100, height=53.0)\n        self._elem_8.place(x=327, y=186)\n        self._elem_9 = ctk.CTkButton(root, text=\"7\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_9, width=100, height=53.0)\n        self._elem_9.place(x=10, y=244)\n        self._elem_10 = ctk.CTkButton(root, text=\"8\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_10, width=100, height=53.0)\n        self._elem_10.place(x=115, y=244)\n        self._elem_11 = ctk.CTkButton(root, text=\"9\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_11, width=100, height=53.0)\n        self._elem_11.place(x=220, y=244)\n        self._elem_12 = ctk.CTkButton(root, text=\"X\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_12, width=100, height=53.0)\n        self._elem_12.place(x=327, y=244)\n        self._elem_13 = ctk.CTkButton(root, text=\"4\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_13, width=100, height=53.0)\n        self._elem_13.place(x=10, y=302)\n        self._elem_14 = ctk.CTkButton(root, text=\"5\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_14, width=100, height=53.0)\n        self._elem_14.place(x=115, y=302)\n        self._elem_15 = ctk.CTkButton(root, text=\"6\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_15, width=100, height=53.0)\n        self._elem_15.place(x=220, y=302)\n        self._elem_16 = ctk.CTkButton(root, text=\"-\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_16, width=100, height=53.0)\n        self._elem_16.place(x=327, y=302)\n        self._elem_17 = ctk.CTkButton(root, text=\"1\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_17, width=100, height=53.0)\n        self._elem_17.place(x=10, y=361)\n        self._elem_18 = ctk.CTkButton(root, text=\"2\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_18, width=100, height=53.0)\n        self._elem_18.place(x=115, y=361)\n        self._elem_19 = ctk.CTkButton(root, text=\"3\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_19, width=100, height=53.0)\n        self._elem_19.place(x=220, y=361)\n        self._elem_20 = ctk.CTkButton(root, text=\"+\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_20, width=100, height=53.0)\n        self._elem_20.place(x=327, y=361)\n        self._elem_21 = ctk.CTkLabel(root, text=\"\", font=('Segoe UI', 33), text_color=\"#f6f6f6\", fg_color=\"#202020\", justify=\"center\", anchor=\"center\", width=440, height=78.0)\n        self._elem_21.place(x=0, y=44)\n        self._elem_22 = ctk.CTkLabel(root, text=\"Standard Calculator\", font=('Segoe UI Black', 20), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", justify=\"center\", anchor=\"center\", width=440, height=39.0)\n        self._elem_22.place(x=0, y=5)\n        self._elem_23 = ctk.CTkButton(root, text=\"+/-\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_23, width=100, height=53.0)\n        self._elem_23.place(x=10, y=419)\n        self._elem_24 = ctk.CTkButton(root, text=\"0\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_24, width=100, height=53.0)\n        self._elem_24.place(x=115, y=419)\n        self._elem_25 = ctk.CTkButton(root, text=\".\", font=('Segoe UI', 16), text_color=\"#f6f6f6\", fg_color=\"#3b3b3b\", command=self._on_Button_25, width=100, height=53.0)\n        self._elem_25.place(x=220, y=419)\n        self._elem_26 = ctk.CTkButton(root, text=\"=\", font=('Segoe UI', 20), text_color=\"#202020\", fg_color=\"#F38064\", command=self._on_Button_26, width=100, height=53.0)\n        self._elem_26.place(x=326, y=419)\n\n        self._update_display()\n        self._bind_keys()\n\n        self._elem_27 = ctk.CTkButton(root, text=\"?\", font=('Segoe UI', 9, 'bold'), text_color=\"#FFFFFF\", fg_color=\"#3b3b3b\", command=self._on_Button_27, corner_radius=0, border_width=0, width=30, height=30)\n        self._elem_27.place(x=391, y=9)\n\n    # ---------- Helper methods ----------\n    def _update_display(self):\n        \"\"\"Update the display label with current expression.\"\"\"\n        if self.error:\n            # Show error message as is\n            self._elem_21.configure(text=self.current)\n            return\n\n        if self.operator is not None:\n            stored_disp = self._format_number(self.stored) if self.stored is not None else \"0\"\n            if self.start_new:\n                # Operator just pressed, waiting for next number\n                display_text = f\"{stored_disp} {self.operator}\"\n            else:\n                display_text = f\"{stored_disp} {self.operator} {self.current}\"\n        else:\n            display_text = self.current\n\n        self._elem_21.configure(text=display_text)\n\n    def _format_number(self, num):\n        try:\n            if abs(num) > 1e12 or (abs(num) < 1e-12 and num != 0):\n                return f\"{num:.8e}\"\n            text = f\"{num:.10f}\".rstrip('0').rstrip('.')\n            return text if text else \"0\"\n        except:\n            return \"Error\"\n\n    def _clear_error_if_needed(self):\n        if self.error:\n            self._clear_all()\n\n    def _press_digit(self, digit):\n        self._clear_error_if_needed()\n        if self.start_new:\n            self.current = \"0\" if digit == \"0\" else digit\n            self.start_new = False\n        else:\n            if self.current in (\"0\", \"-0\"):\n                if digit != \"0\":\n                    self.current = (\"-\" if self.current == \"-0\" else \"\") + digit\n                else:\n                    return\n            else:\n                self.current += digit\n        self._update_display()\n\n    def _press_decimal(self):\n        self._clear_error_if_needed()\n        if self.start_new:\n            self.current = \"0.\"\n            self.start_new = False\n        else:\n            if \".\" not in self.current:\n                self.current += \".\"\n        self._update_display()\n\n    def _backspace(self):\n        self._clear_error_if_needed()\n        if self.start_new:\n            # If after equals (result generated) and current is not zero/error, start editing that number\n            if self.current not in (\"0\", \"-0\") and not self.error:\n                self.start_new = False\n            else:\n                self.current = \"0\"\n                self.start_new = False\n                self._update_display()\n                return\n        # Normal backspace\n        if len(self.current) > 1:\n            self.current = self.current[:-1]\n            if self.current in (\"-\", \"\"):\n                self.current = \"0\"\n        else:\n            self.current = \"0\"\n        self._update_display()\n\n    def _clear_entry(self):\n        self.current = \"0\"\n        self.start_new = True\n        self.error = False\n        self._update_display()\n\n    def _clear_all(self):\n        self.current = \"0\"\n        self.stored = None\n        self.operator = None\n        self.start_new = True\n        self.error = False\n        self._update_display()\n\n    def _percent(self):\n        self._clear_error_if_needed()\n        try:\n            val = float(self.current)\n            result = val / 100\n            self.current = self._format_number(result)\n            self.start_new = True\n        except:\n            self.current = \"Error\"\n            self.error = True\n        self._update_display()\n\n    def _reciprocal(self):\n        self._clear_error_if_needed()\n        try:\n            val = float(self.current)\n            if val == 0:\n                self.current = \"Cannot divide by zero\"\n                self.error = True\n            else:\n                self.current = self._format_number(1 / val)\n                self.start_new = True\n        except:\n            self.current = \"Error\"\n            self.error = True\n        self._update_display()\n\n    def _square(self):\n        self._clear_error_if_needed()\n        try:\n            val = float(self.current)\n            self.current = self._format_number(val ** 2)\n            self.start_new = True\n        except:\n            self.current = \"Error\"\n            self.error = True\n        self._update_display()\n\n    def _sqrt(self):\n        self._clear_error_if_needed()\n        try:\n            val = float(self.current)\n            if val < 0:\n                self.current = \"Invalid input\"\n                self.error = True\n            else:\n                self.current = self._format_number(math.sqrt(val))\n                self.start_new = True\n        except:\n            self.current = \"Error\"\n            self.error = True\n        self._update_display()\n\n    def _toggle_sign(self):\n        self._clear_error_if_needed()\n        if self.current.startswith(\"-\"):\n            self.current = self.current[1:]\n        else:\n            self.current = \"-\" + self.current\n        self._update_display()\n\n    def _compute(self, a, b, op):\n        try:\n            if op == \"+\":\n                return a + b\n            if op == \"-\":\n                return a - b\n            if op == \"X\":\n                return a * b\n            if op == \"\u00f7\":\n                if b == 0:\n                    return None\n                return a / b\n            return None\n        except:\n            return None\n\n    def _set_operator(self, op):\n        self._clear_error_if_needed()\n        if not self.start_new:\n            # If there's a pending operation, compute it first\n            if self.operator is not None and self.stored is not None:\n                result = self._compute(self.stored, float(self.current), self.operator)\n                if result is None:\n                    self.current = \"Cannot divide by zero\"\n                    self.error = True\n                    self._update_display()\n                    return\n                self.current = self._format_number(result)\n                self.stored = result\n            else:\n                self.stored = float(self.current)\n        else:\n            # start_new is True, so current is already the result or initial number\n            self.stored = float(self.current)\n\n        self.operator = op\n        self.start_new = True\n        self._update_display()\n\n    def _equals(self):\n        self._clear_error_if_needed()\n        if self.operator is not None and self.stored is not None:\n            try:\n                a = self.stored\n                b = float(self.current)\n                result = self._compute(a, b, self.operator)\n                if result is None:\n                    self.current = \"Cannot divide by zero\"\n                    self.error = True\n                else:\n                    self.current = self._format_number(result)\n                    self.stored = result\n                    self.operator = None\n            except:\n                self.current = \"Error\"\n                self.error = True\n            self.start_new = True\n            self._update_display()\n\n    # ---------- Keyboard bindings ----------\n    def _bind_keys(self):\n        self.root.bind_all(\"<Key>\", self._on_key_press)\n\n    def _on_key_press(self, event):\n        key = event.keysym\n        char = event.char\n\n        # Digits\n        if char.isdigit():\n            self._press_digit(char)\n            return \"break\"\n\n        # Decimal point\n        elif char == '.':\n            self._press_decimal()\n            return \"break\"\n\n        # Operators\n        elif char == '+':\n            self._set_operator('+')\n            return \"break\"\n        elif char == '-':\n            self._set_operator('-')\n            return \"break\"\n        elif char in ('*', 'x', 'X'):\n            self._set_operator('X')\n            return \"break\"\n        elif char == '/':\n            self._set_operator('\u00f7')\n            return \"break\"\n\n        # Equals\n        elif key in ('Return', 'KP_Enter'):\n            self._equals()\n            return \"break\"\n\n        # Backspace\n        elif key == 'BackSpace':\n            self._backspace()\n            return \"break\"\n\n        # Clear\n        elif key == 'Escape':\n            self._clear_all()\n            return \"break\"\n        elif key == 'Delete':\n            self._clear_entry()\n            return \"break\"\n\n        # Percent\n        elif char == '%':\n            self._percent()\n            return \"break\"\n\n        # Special functions\n        elif char in ('r', 'R'):\n            self._reciprocal()\n            return \"break\"\n        elif char in ('s', 'S'):\n            self._sqrt()\n            return \"break\"\n        elif char == '^':\n            self._square()\n            return \"break\"\n        elif char in ('n', 'N'):\n            self._toggle_sign()\n            return \"break\"\n\n        # Number pad keys (digits and operators)\n        elif key.startswith('KP_'):\n            kp_map = {\n                'KP_0': '0', 'KP_1': '1', 'KP_2': '2', 'KP_3': '3', 'KP_4': '4',\n                'KP_5': '5', 'KP_6': '6', 'KP_7': '7', 'KP_8': '8', 'KP_9': '9',\n                'KP_Add': '+', 'KP_Subtract': '-', 'KP_Multiply': 'X', 'KP_Divide': '\u00f7',\n                'KP_Decimal': '.', 'KP_Enter': '='\n            }\n            if key in kp_map:\n                val = kp_map[key]\n                if val.isdigit():\n                    self._press_digit(val)\n                elif val == '.':\n                    self._press_decimal()\n                elif val == '+':\n                    self._set_operator('+')\n                elif val == '-':\n                    self._set_operator('-')\n                elif val == 'X':\n                    self._set_operator('X')\n                elif val == '\u00f7':\n                    self._set_operator('\u00f7')\n                elif val == '=':\n                    self._equals()\n                return \"break\"\n\n        # No action for other keys\n        return None\n\n    # ---------- Button event handlers ----------\n    def _on_Button_1(self, event=None):\n        self._percent()\n\n    def _on_Button_2(self, event=None):\n        self._clear_entry()\n\n    def _on_Button_3(self, event=None):\n        self._clear_all()\n\n    def _on_Button_4(self, event=None):\n        self._backspace()\n\n    def _on_Button_5(self, event=None):\n        self._reciprocal()\n\n    def _on_Button_6(self, event=None):\n        self._square()\n\n    def _on_Button_7(self, event=None):\n        self._sqrt()\n\n    def _on_Button_8(self, event=None):\n        self._set_operator(\"\u00f7\")\n\n    def _on_Button_9(self, event=None):\n        self._press_digit(\"7\")\n\n    def _on_Button_10(self, event=None):\n        self._press_digit(\"8\")\n\n    def _on_Button_11(self, event=None):\n        self._press_digit(\"9\")\n\n    def _on_Button_12(self, event=None):\n        self._set_operator(\"X\")\n\n    def _on_Button_13(self, event=None):\n        self._press_digit(\"4\")\n\n    def _on_Button_14(self, event=None):\n        self._press_digit(\"5\")\n\n    def _on_Button_15(self, event=None):\n        self._press_digit(\"6\")\n\n    def _on_Button_16(self, event=None):\n        self._set_operator(\"-\")\n\n    def _on_Button_17(self, event=None):\n        self._press_digit(\"1\")\n\n    def _on_Button_18(self, event=None):\n        self._press_digit(\"2\")\n\n    def _on_Button_19(self, event=None):\n        self._press_digit(\"3\")\n\n    def _on_Button_20(self, event=None):\n        self._set_operator(\"+\")\n\n    def _on_Button_23(self, event=None):\n        self._toggle_sign()\n\n    def _on_Button_24(self, event=None):\n        self._press_digit(\"0\")\n\n    def _on_Button_25(self, event=None):\n        self._press_decimal()\n\n    def _on_Button_26(self, event=None):\n        self._equals()\n\n    def _on_Button_27(self, event=None):\n        \"\"\"Show keyboard shortcuts popup (excluding numeric and operator keys).\"\"\"\n        popup = ctk.CTkToplevel(self.root)\n        popup.title(\"Keyboard Shortcuts\")\n        popup.geometry(\"350x300\")\n        popup.resizable(False, False)\n        popup.attributes(\"-topmost\", True)\n\n        shortcuts_text = \"\"\"Keyboard Shortcuts (excluding numeric and operator keys):\n\n        Backspace  - Delete last character\n        Escape     - Clear all (C)\n        Delete     - Clear entry (CE)\n        %          - Percent\n        r or R     - Reciprocal (1/x)\n        s or S     - Square root (\u221ax)\n        ^          - Square (x\u00b2)\n        n or N     - Toggle sign (+/-)\n        Enter or = - Equals\n        \"\"\"\n\n        label = ctk.CTkLabel(popup, text=shortcuts_text, font=('Segoe UI', 14), justify=\"left\", anchor=\"w\")\n        label.pack(pady=20, padx=20, fill=\"both\", expand=True)\n\n        close_btn = ctk.CTkButton(popup, text=\"Close\", command=popup.destroy, width=100)\n        close_btn.pack(pady=10)\n\n        popup.grab_set()\n        popup.focus_force()\n\n\nif __name__ == '__main__':\n    root = ctk.CTk()\n    app = MainApplication(root)\n    root.mainloop()", "custom_module_code": "", "custom_class_code": "    def _update_display(self):\n        \"\"\"Update the display label with current expression.\"\"\"\n        if self.error:\n            # Show error message as is\n            self._elem_21.configure(text=self.current)\n            return\n\n        if self.operator is not None:\n            stored_disp = self._format_number(self.stored) if self.stored is not None else \"0\"\n            if self.start_new:\n                # Operator just pressed, waiting for next number\n                display_text = f\"{stored_disp} {self.operator}\"\n            else:\n                display_text = f\"{stored_disp} {self.operator} {self.current}\"\n        else:\n            display_text = self.current\n\n        self._elem_21.configure(text=display_text)\n\n    def _format_number(self, num):\n        try:\n            if abs(num) > 1e12 or (abs(num) < 1e-12 and num != 0):\n                return f\"{num:.8e}\"\n            text = f\"{num:.10f}\".rstrip('0').rstrip('.')\n            return text if text else \"0\"\n        except:\n            return \"Error\"\n\n    def _clear_error_if_needed(self):\n        if self.error:\n            self._clear_all()\n\n    def _press_digit(self, digit):\n        self._clear_error_if_needed()\n        if self.start_new:\n            self.current = \"0\" if digit == \"0\" else digit\n            self.start_new = False\n        else:\n            if self.current in (\"0\", \"-0\"):\n                if digit != \"0\":\n                    self.current = (\"-\" if self.current == \"-0\" else \"\") + digit\n                else:\n                    return\n            else:\n                self.current += digit\n        self._update_display()\n\n    def _press_decimal(self):\n        self._clear_error_if_needed()\n        if self.start_new:\n            self.current = \"0.\"\n            self.start_new = False\n        else:\n            if \".\" not in self.current:\n                self.current += \".\"\n        self._update_display()\n\n    def _backspace(self):\n        self._clear_error_if_needed()\n        if self.start_new:\n            # If after equals (result generated) and current is not zero/error, start editing that number\n            if self.current not in (\"0\", \"-0\") and not self.error:\n                self.start_new = False\n            else:\n                self.current = \"0\"\n                self.start_new = False\n                self._update_display()\n                return\n        # Normal backspace\n        if len(self.current) > 1:\n            self.current = self.current[:-1]\n            if self.current in (\"-\", \"\"):\n                self.current = \"0\"\n        else:\n            self.current = \"0\"\n        self._update_display()\n\n    def _clear_entry(self):\n        self.current = \"0\"\n        self.start_new = True\n        self.error = False\n        self._update_display()\n\n    def _clear_all(self):\n        self.current = \"0\"\n        self.stored = None\n        self.operator = None\n        self.start_new = True\n        self.error = False\n        self._update_display()\n\n    def _percent(self):\n        self._clear_error_if_needed()\n        try:\n            val = float(self.current)\n            result = val / 100\n            self.current = self._format_number(result)\n            self.start_new = True\n        except:\n            self.current = \"Error\"\n            self.error = True\n        self._update_display()\n\n    def _reciprocal(self):\n        self._clear_error_if_needed()\n        try:\n            val = float(self.current)\n            if val == 0:\n                self.current = \"Cannot divide by zero\"\n                self.error = True\n            else:\n                self.current = self._format_number(1 / val)\n                self.start_new = True\n        except:\n            self.current = \"Error\"\n            self.error = True\n        self._update_display()\n\n    def _square(self):\n        self._clear_error_if_needed()\n        try:\n            val = float(self.current)\n            self.current = self._format_number(val ** 2)\n            self.start_new = True\n        except:\n            self.current = \"Error\"\n            self.error = True\n        self._update_display()\n\n    def _sqrt(self):\n        self._clear_error_if_needed()\n        try:\n            val = float(self.current)\n            if val < 0:\n                self.current = \"Invalid input\"\n                self.error = True\n            else:\n                self.current = self._format_number(math.sqrt(val))\n                self.start_new = True\n        except:\n            self.current = \"Error\"\n            self.error = True\n        self._update_display()\n\n    def _toggle_sign(self):\n        self._clear_error_if_needed()\n        if self.current.startswith(\"-\"):\n            self.current = self.current[1:]\n        else:\n            self.current = \"-\" + self.current\n        self._update_display()\n\n    def _compute(self, a, b, op):\n        try:\n            if op == \"+\":\n                return a + b\n            if op == \"-\":\n                return a - b\n            if op == \"X\":\n                return a * b\n            if op == \"\u00f7\":\n                if b == 0:\n                    return None\n                return a / b\n            return None\n        except:\n            return None\n\n    def _set_operator(self, op):\n        self._clear_error_if_needed()\n        if not self.start_new:\n            # If there's a pending operation, compute it first\n            if self.operator is not None and self.stored is not None:\n                result = self._compute(self.stored, float(self.current), self.operator)\n                if result is None:\n                    self.current = \"Cannot divide by zero\"\n                    self.error = True\n                    self._update_display()\n                    return\n                self.current = self._format_number(result)\n                self.stored = result\n            else:\n                self.stored = float(self.current)\n        else:\n            # start_new is True, so current is already the result or initial number\n            self.stored = float(self.current)\n\n        self.operator = op\n        self.start_new = True\n        self._update_display()\n\n    def _equals(self):\n        self._clear_error_if_needed()\n        if self.operator is not None and self.stored is not None:\n            try:\n                a = self.stored\n                b = float(self.current)\n                result = self._compute(a, b, self.operator)\n                if result is None:\n                    self.current = \"Cannot divide by zero\"\n                    self.error = True\n                else:\n                    self.current = self._format_number(result)\n                    self.stored = result\n                    self.operator = None\n            except:\n                self.current = \"Error\"\n                self.error = True\n            self.start_new = True\n            self._update_display()\n\n    # ---------- Keyboard bindings ----------\n    def _bind_keys(self):\n        self.root.bind_all(\"<Key>\", self._on_key_press)\n\n    def _on_key_press(self, event):\n        key = event.keysym\n        char = event.char\n\n        # Digits\n        if char.isdigit():\n            self._press_digit(char)\n            return \"break\"\n\n        # Decimal point\n        elif char == '.':\n            self._press_decimal()\n            return \"break\"\n\n        # Operators\n        elif char == '+':\n            self._set_operator('+')\n            return \"break\"\n        elif char == '-':\n            self._set_operator('-')\n            return \"break\"\n        elif char in ('*', 'x', 'X'):\n            self._set_operator('X')\n            return \"break\"\n        elif char == '/':\n            self._set_operator('\u00f7')\n            return \"break\"\n\n        # Equals\n        elif key in ('Return', 'KP_Enter'):\n            self._equals()\n            return \"break\"\n\n        # Backspace\n        elif key == 'BackSpace':\n            self._backspace()\n            return \"break\"\n\n        # Clear\n        elif key == 'Escape':\n            self._clear_all()\n            return \"break\"\n        elif key == 'Delete':\n            self._clear_entry()\n            return \"break\"\n\n        # Percent\n        elif char == '%':\n            self._percent()\n            return \"break\"\n\n        # Special functions\n        elif char in ('r', 'R'):\n            self._reciprocal()\n            return \"break\"\n        elif char in ('s', 'S'):\n            self._sqrt()\n            return \"break\"\n        elif char == '^':\n            self._square()\n            return \"break\"\n        elif char in ('n', 'N'):\n            self._toggle_sign()\n            return \"break\"\n\n        # Number pad keys (digits and operators)\n        elif key.startswith('KP_'):\n            kp_map = {\n                'KP_0': '0', 'KP_1': '1', 'KP_2': '2', 'KP_3': '3', 'KP_4': '4',\n                'KP_5': '5', 'KP_6': '6', 'KP_7': '7', 'KP_8': '8', 'KP_9': '9',\n                'KP_Add': '+', 'KP_Subtract': '-', 'KP_Multiply': 'X', 'KP_Divide': '\u00f7',\n                'KP_Decimal': '.', 'KP_Enter': '='\n            }\n            if key in kp_map:\n                val = kp_map[key]\n                if val.isdigit():\n                    self._press_digit(val)\n                elif val == '.':\n                    self._press_decimal()\n                elif val == '+':\n                    self._set_operator('+')\n                elif val == '-':\n                    self._set_operator('-')\n                elif val == 'X':\n                    self._set_operator('X')\n                elif val == '\u00f7':\n                    self._set_operator('\u00f7')\n                elif val == '=':\n                    self._equals()\n                return \"break\"\n\n        # No action for other keys\n        return None\n\n    # ---------- Button event handlers ----------"}