", "parent_id": null, "parent_tab": null, "elem_id": 11}, {"elem_type": "Button", "x": 210, "y": 239, "canvas_w": 69.0, "canvas_h": 34, "props": {"text": 6, "font": ["Times New Roman Baltic", 14], "fg": "#ffffff", "bg": "#019459", "relief": "raised", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 2).\nTriggered by: command\nAccess widget instance via: self._elem_2\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 12}, {"elem_type": "Button", "x": 310, "y": 239, "canvas_w": 69.0, "canvas_h": 34, "props": {"text": "-", "font": ["Times New Roman Baltic", 14], "fg": "#ffffff", "bg": "#019459", "relief": "raised", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 2).\nTriggered by: command\nAccess widget instance via: self._elem_2\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 13}, {"elem_type": "Button", "x": 10, "y": 299, "canvas_w": 69.0, "canvas_h": 34, "props": {"text": 1, "font": ["Times New Roman Baltic", 14], "fg": "#ffffff", "bg": "#019459", "relief": "raised", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 2).\nTriggered by: command\nAccess widget instance via: self._elem_2\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 14}, {"elem_type": "Button", "x": 110, "y": 299, "canvas_w": 69.0, "canvas_h": 34, "props": {"text": 2, "font": ["Times New Roman Baltic", 14], "fg": "#ffffff", "bg": "#019459", "relief": "raised", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 2).\nTriggered by: command\nAccess widget instance via: self._elem_2\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 15}, {"elem_type": "Button", "x": 210, "y": 300, "canvas_w": 69.0, "canvas_h": 34, "props": {"text": 3, "font": ["Times New Roman Baltic", 14], "fg": "#ffffff", "bg": "#019459", "relief": "raised", "command": ""}, "handler_code": "self._elem_1.configure(text=f\"{self._elem_1['text']}3\")", "parent_id": null, "parent_tab": null, "elem_id": 16}, {"elem_type": "Button", "x": 310, "y": 299, "canvas_w": 69.0, "canvas_h": 35.0, "props": {"text": "+", "font": ["Times New Roman Baltic", 14], "fg": "#ffffff", "bg": "#019459", "relief": "raised", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 2).\nTriggered by: command\nAccess widget instance via: self._elem_2\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 17}, {"elem_type": "Button", "x": 10, "y": 359, "canvas_w": 170.0, "canvas_h": 34, "props": {"text": 0, "font": ["Times New Roman Baltic", 14], "fg": "#ffffff", "bg": "#019459", "relief": "raised", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 2).\nTriggered by: command\nAccess widget instance via: self._elem_2\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 18}, {"elem_type": "Button", "x": 210, "y": 359, "canvas_w": 69.0, "canvas_h": 34, "props": {"text": ".", "font": ["Wide Latin", 14], "fg": "#ffffff", "bg": "#019459", "relief": "raised", "command": ""}, "handler_code": "\"\"\"\nEvent handler for Button (ID: 2).\nTriggered by: command\nAccess widget instance via: self._elem_2\n\"\"\"\npass", "parent_id": null, "parent_tab": null, "elem_id": 20}, {"elem_type": "Label", "x": 3.0, "y": 38, "canvas_w": 393.0, "canvas_h": 64.0, "props": {"text": "", "font": ["Bahnschrift", 24], "fg": "black", "bg": "#e8fff1", "relief": "sunken", "justify": "left"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 1}, {"elem_type": "Button", "x": 310, "y": 360, "canvas_w": 69.0, "canvas_h": 34, "props": {"text": "=", "font": ["Times New Roman Baltic", 14], "fg": "#ffffff", "bg": "#019459", "relief": "raised", "command": ""}, "handler_code": "\"\"\"Equals button ('=')\"\"\"\ntry:\n    expression = self._elem_1['text']\n    # Evaluate the mathematical expression safely\n    result = eval(expression)\n    self._elem_1.configure(text=str(result))\nexcept Exception:\n    self._elem_1.configure(text=\"Error\")", "parent_id": null, "parent_tab": null, "elem_id": 19}, {"elem_type": "Separator", "x": 0, "y": 112, "canvas_w": 400, "canvas_h": 4, "props": {"orient": "horizontal"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 21}, {"elem_type": "Separator", "x": 0, "y": 166, "canvas_w": 400, "canvas_h": 4, "props": {"orient": "horizontal"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 22}, {"elem_type": "Separator", "x": 0, "y": 226, "canvas_w": 400, "canvas_h": 4, "props": {"orient": "horizontal"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 23}, {"elem_type": "Separator", "x": 0, "y": 286, "canvas_w": 400, "canvas_h": 4, "props": {"orient": "horizontal"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 24}, {"elem_type": "Separator", "x": 0, "y": 346, "canvas_w": 400, "canvas_h": 4, "props": {"orient": "horizontal"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 25}, {"elem_type": "Separator", "x": 92, "y": 115, "canvas_w": 4, "canvas_h": 234, "props": {"orient": "vertical"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 26}, {"elem_type": "Separator", "x": 191, "y": 115.0, "canvas_w": 4, "canvas_h": 285.0, "props": {"orient": "vertical"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 27}, {"elem_type": "Separator", "x": 292, "y": 112.0, "canvas_w": 4, "canvas_h": 288.0, "props": {"orient": "vertical"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 28}, {"elem_type": "Label", "x": 0, "y": 0, "canvas_w": 400, "canvas_h": 38.0, "props": {"text": "CALCULATOR", "font": ["Fixedsys", 20], "fg": "#212121", "bg": "#F5F5F5", "relief": "flat", "justify": "center"}, "handler_code": "", "parent_id": null, "parent_tab": null, "elem_id": 29}], "next_id": 30, "reusable_ids": [], "window_title": "Calculator", "canvas_w": 400, "canvas_h": 400, "canvas_bg": "#ffffff", "canvas_imports": "import tkinter as tk\nfrom tkinter import ttk", "full_code": "\"\"\"Generated by Tkinter Visual Designer.\"\"\"\n\nimport tkinter as tk\nfrom tkinter import ttk\nimport pandas as pd\n\nclass MainApplication:\n    def __init__(self, root):\n        self.root = root\n        root.title(\"Calculator\")\n        root.geometry(\"400x400\")\n        root.configure(bg=\"#ffffff\")\n\n        self._elem_1 = tk.Label(root, text=\"\", font=['Bahnschrift', 24], fg=\"black\", bg=\"#e8fff1\", relief=\"sunken\", justify=\"left\")\n        self._elem_1.place(x=3.0, y=38, width=393.0, height=64.0)\n        self._elem_2 = tk.Button(root, text=\"C\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_2)\n        self._elem_2.place(x=10, y=119, width=69.0, height=34)\n        self._elem_3 = tk.Button(root, text=\"%\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_3)\n        self._elem_3.place(x=110, y=119, width=69.0, height=34)\n        self._elem_4 = tk.Button(root, text=\"\\u2190\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_4)\n        self._elem_4.place(x=210, y=119, width=69.0, height=34)\n        self._elem_5 = tk.Button(root, text=\"/\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_5)\n        self._elem_5.place(x=310, y=119, width=69.0, height=34)\n        self._elem_6 = tk.Button(root, text=7, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_6)\n        self._elem_6.place(x=10, y=179, width=69.0, height=34)\n        self._elem_7 = tk.Button(root, text=8, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_7)\n        self._elem_7.place(x=110, y=180, width=69.0, height=34)\n        self._elem_8 = tk.Button(root, text=9, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_8)\n        self._elem_8.place(x=210, y=179, width=69.0, height=34)\n        self._elem_9 = tk.Button(root, text=\"X\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_9)\n        self._elem_9.place(x=310, y=179, width=69.0, height=34)\n        self._elem_10 = tk.Button(root, text=4, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_10)\n        self._elem_10.place(x=10, y=239, width=69.0, height=34)\n        self._elem_11 = tk.Button(root, text=5, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_11)\n        self._elem_11.place(x=110, y=240, width=69.0, height=34)\n        self._elem_12 = tk.Button(root, text=6, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_12)\n        self._elem_12.place(x=210, y=239, width=69.0, height=34)\n        self._elem_13 = tk.Button(root, text=\"-\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_13)\n        self._elem_13.place(x=310, y=239, width=69.0, height=34)\n        self._elem_14 = tk.Button(root, text=1, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_14)\n        self._elem_14.place(x=10, y=299, width=69.0, height=34)\n        self._elem_15 = tk.Button(root, text=2, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_15)\n        self._elem_15.place(x=110, y=299, width=69.0, height=34)\n        self._elem_16 = tk.Button(root, text=3, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_16)\n        self._elem_16.place(x=210, y=300, width=69.0, height=34)\n        self._elem_17 = tk.Button(root, text=\"+\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_17)\n        self._elem_17.place(x=310, y=299, width=69.0, height=35.0)\n        self._elem_18 = tk.Button(root, text=0, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_18)\n        self._elem_18.place(x=10, y=359, width=170.0, height=34)\n        self._elem_19 = tk.Button(root, text=\"=\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_19)\n        self._elem_19.place(x=310, y=359, width=69.0, height=34)\n        self._elem_20 = tk.Button(root, text=\".\", font=['Wide Latin', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_20)\n        self._elem_20.place(x=210, y=359, width=69.0, height=34)\n\n        self._elem_21 = ttk.Separator(root, orient=\"horizontal\")\n        self._elem_21.place(x=0, y=112, width=400, height=4)\n        self._elem_22 = ttk.Separator(root, orient=\"horizontal\")\n        self._elem_22.place(x=0, y=166, width=400, height=4)\n        self._elem_23 = ttk.Separator(root, orient=\"horizontal\")\n        self._elem_23.place(x=0, y=226, width=400, height=4)\n        self._elem_24 = ttk.Separator(root, orient=\"horizontal\")\n        self._elem_24.place(x=0, y=286, width=400, height=4)\n        self._elem_25 = ttk.Separator(root, orient=\"horizontal\")\n        self._elem_25.place(x=0, y=346, width=400, height=4)\n        self._elem_26 = ttk.Separator(root, orient=\"vertical\")\n        self._elem_26.place(x=92, y=115, width=4, height=234)\n        self._elem_27 = ttk.Separator(root, orient=\"vertical\")\n        self._elem_27.place(x=191, y=115.0, width=4, height=285.0)\n        self._elem_28 = ttk.Separator(root, orient=\"vertical\")\n        self._elem_28.place(x=292, y=112.0, width=4, height=288.0)\n        self._elem_29 = tk.Label(root, text=\"CALCULATOR\", font=['Fixedsys', 20], fg=\"#212121\", bg=\"#F5F5F5\", relief=\"flat\", justify=\"center\")\n        self._elem_29.place(x=0, y=0, width=400, height=38.0)\n\n        # --- Add Keyboard Bindings ---\n        root.bind(\"<Key>\", self._on_key_press)\n\n    def _on_key_press(self, event):\n        \"\"\"Handle keyboard input bindings.\"\"\"\n        char = event.char\n        keysym = event.keysym\n\n        if char in \"0123456789\":\n            # Map number keys\n            num_map = {\n                '0': self._on_Button_18, '1': self._on_Button_14,\n                '2': self._on_Button_15, '3': self._on_Button_16,\n                '4': self._on_Button_10, '5': self._on_Button_11,\n                '6': self._on_Button_12, '7': self._on_Button_6,\n                '8': self._on_Button_7, '9': self._on_Button_8\n            }\n            num_map[char]()\n        elif char == '+':\n            self._on_Button_17()\n        elif char == '-':\n            self._on_Button_13()\n        elif char in ('*', 'x', 'X'):\n            self._on_Button_9()\n        elif char == '/':\n            self._on_Button_5()\n        elif char == '%':\n            self._on_Button_3()\n        elif char == '.':\n            self._on_Button_20()\n        elif keysym in ('Return', 'KP_Enter') or char == '=':\n            self._on_Button_19()\n        elif keysym == 'BackSpace':\n            self._on_Button_4()\n        elif keysym in ('Escape', 'c', 'C'):\n            self._on_Button_2()\n\n    def _on_Button_2(self, event=None):\n        \"\"\"Clear button ('C')\"\"\"\n        self._elem_1.configure(text=\"\")\n\n    def _on_Button_3(self, event=None):\n        \"\"\"Percentage button ('%')\"\"\"\n        try:\n            current_val = float(self._elem_1['text'])\n            self._elem_1.configure(text=str(current_val / 100))\n        except Exception:\n            self._elem_1.configure(text=\"Error\")\n\n    def _on_Button_4(self, event=None):\n        \"\"\"Backspace button ('\u2190')\"\"\"\n        current_text = self._elem_1['text']\n        self._elem_1.configure(text=current_text[:-1])\n\n    def _on_Button_5(self, event=None):\n        \"\"\"Division button ('/')\"\"\"\n        self._elem_1.configure(text=f\"{self._elem_1['text']}/\")\n\n    def _on_Button_6(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}7\")\n\n    def _on_Button_7(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}8\")\n\n    def _on_Button_8(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}9\")\n\n    def _on_Button_9(self, event=None):\n        \"\"\"Multiplication button ('X') - replaced with '*' for eval\"\"\"\n        self._elem_1.configure(text=f\"{self._elem_1['text']}*\")\n\n    def _on_Button_10(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}4\")\n\n    def _on_Button_11(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}5\")\n\n    def _on_Button_12(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}6\")\n\n    def _on_Button_13(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}-\")\n\n    def _on_Button_14(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}1\")\n\n    def _on_Button_15(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}2\")\n\n    def _on_Button_16(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}3\")\n\n    def _on_Button_17(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}+\")\n\n    def _on_Button_18(self, event=None):\n        \"\"\"Zero button ('0')\"\"\"\n        self._elem_1.configure(text=f\"{self._elem_1['text']}0\")\n\n    def _on_Button_20(self, event=None):\n        \"\"\"Decimal point button ('.')\"\"\"\n        self._elem_1.configure(text=f\"{self._elem_1['text']}.\")\n\n    def _on_Button_19(self, event=None):\n        \"\"\"Equals button ('=')\"\"\"\n        try:\n            expression = self._elem_1['text']\n            # Evaluate the mathematical expression safely\n            result = eval(expression)\n            self._elem_1.configure(text=str(result))\n        except Exception:\n            self._elem_1.configure(text=\"Error\")\n\n\nif __name__ == '__main__':\n    root = tk.Tk()\n    app = MainApplication(root)\n    root.mainloop()"}