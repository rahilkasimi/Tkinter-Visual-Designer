d": null, "parent_tab": null, "elem_id": 19}], "next_id": 22, "reusable_ids": [21], "window_title": "Calculator", "canvas_w": 400, "canvas_h": 400, "canvas_bg": "#ffffff", "canvas_imports": "import tkinter as tk\nfrom tkinter import ttk", "full_code": "\"\"\"Generated by Tkinter Visual Designer.\"\"\"\n\nimport tkinter as tk\nfrom tkinter import ttk\nimport pandas as pd\n\nclass MainApplication:\n    def __init__(self, root):\n        self.root = root\n        root.title(\"Calculator\")\n        root.geometry(\"400x400\")\n        root.configure(bg=\"#ffffff\")\n\n        self._elem_1 = tk.Label(root, text=\"\", font=['Bahnschrift', 24], fg=\"black\", bg=\"#e8fff1\", relief=\"ridge\", justify=\"left\")\n        self._elem_1.place(x=3.0, y=10, width=393.0, height=64.0)\n        self._elem_2 = tk.Button(root, text=\"C\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_2)\n        self._elem_2.place(x=10, y=96, width=69.0, height=34)\n        self._elem_3 = tk.Button(root, text=\"%\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_3)\n        self._elem_3.place(x=110, y=96, width=69.0, height=34)\n        self._elem_4 = tk.Button(root, text=\"\\u2190\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_4)\n        self._elem_4.place(x=210, y=96, width=69.0, height=34)\n        self._elem_5 = tk.Button(root, text=\"/\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_5)\n        self._elem_5.place(x=310, y=96, width=69.0, height=34)\n        self._elem_6 = tk.Button(root, text=7, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_6)\n        self._elem_6.place(x=10, y=156, width=69.0, height=34)\n        self._elem_7 = tk.Button(root, text=8, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_7)\n        self._elem_7.place(x=110, y=156, width=69.0, height=34)\n        self._elem_8 = tk.Button(root, text=9, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_8)\n        self._elem_8.place(x=210, y=156, width=69.0, height=34)\n        self._elem_9 = tk.Button(root, text=\"X\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_9)\n        self._elem_9.place(x=310, y=156, width=69.0, height=34)\n        self._elem_10 = tk.Button(root, text=4, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_10)\n        self._elem_10.place(x=10, y=216, width=69.0, height=34)\n        self._elem_11 = tk.Button(root, text=5, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_11)\n        self._elem_11.place(x=110, y=216, width=69.0, height=34)\n        self._elem_12 = tk.Button(root, text=6, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_12)\n        self._elem_12.place(x=210, y=216, width=69.0, height=34)\n        self._elem_13 = tk.Button(root, text=\"-\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_13)\n        self._elem_13.place(x=310, y=216, width=69.0, height=34)\n        self._elem_14 = tk.Button(root, text=1, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_14)\n        self._elem_14.place(x=10, y=276, width=69.0, height=34)\n        self._elem_15 = tk.Button(root, text=2, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_15)\n        self._elem_15.place(x=110, y=276, width=69.0, height=34)\n        self._elem_16 = tk.Button(root, text=3, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_16)\n        self._elem_16.place(x=210, y=276, width=69.0, height=34)\n        self._elem_17 = tk.Button(root, text=\"+\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_17)\n        self._elem_17.place(x=310, y=276, width=69.0, height=35.0)\n        self._elem_18 = tk.Button(root, text=0, font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_18)\n        self._elem_18.place(x=10, y=336, width=170.0, height=34)\n        self._elem_19 = tk.Button(root, text=\"=\", font=['Times New Roman Baltic', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_19)\n        self._elem_19.place(x=310, y=336, width=69.0, height=34)\n        self._elem_20 = tk.Button(root, text=\".\", font=['Wide Latin', 14], fg=\"#ffffff\", bg=\"#019459\", relief=\"raised\", command=self._on_Button_20)\n        self._elem_20.place(x=210, y=336, width=69.0, height=34)\n\n    def _on_Button_2(self, event=None):\n        \"\"\"Clear button ('C')\"\"\"\n        self._elem_1.configure(text=\"\")\n\n    def _on_Button_3(self, event=None):\n        \"\"\"Percentage button ('%')\"\"\"\n        try:\n            current_val = float(self._elem_1['text'])\n            self._elem_1.configure(text=str(current_val / 100))\n        except Exception:\n            self._elem_1.configure(text=\"Error\")\n\n    def _on_Button_4(self, event=None):\n        \"\"\"Backspace button ('\u2190')\"\"\"\n        current_text = self._elem_1['text']\n        self._elem_1.configure(text=current_text[:-1])\n\n    def _on_Button_5(self, event=None):\n        \"\"\"Division button ('/')\"\"\"\n        self._elem_1.configure(text=f\"{self._elem_1['text']}/\")\n\n    def _on_Button_6(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}7\")\n\n    def _on_Button_7(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}8\")\n\n    def _on_Button_8(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}9\")\n\n    def _on_Button_9(self, event=None):\n        \"\"\"Multiplication button ('X') - replaced with '*' for eval\"\"\"\n        self._elem_1.configure(text=f\"{self._elem_1['text']}*\")\n\n    def _on_Button_10(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}4\")\n\n    def _on_Button_11(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}5\")\n\n    def _on_Button_12(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}6\")\n\n    def _on_Button_13(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}-\")\n\n    def _on_Button_14(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}1\")\n\n    def _on_Button_15(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}2\")\n\n    def _on_Button_16(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}3\")\n\n    def _on_Button_17(self, event=None):\n        self._elem_1.configure(text=f\"{self._elem_1['text']}+\")\n\n    def _on_Button_18(self, event=None):\n        \"\"\"Zero button ('0')\"\"\"\n        self._elem_1.configure(text=f\"{self._elem_1['text']}0\")\n\n    def _on_Button_20(self, event=None):\n        \"\"\"Decimal point button ('.')\"\"\"\n        self._elem_1.configure(text=f\"{self._elem_1['text']}.\")\n\n    def _on_Button_19(self, event=None):\n        \"\"\"Equals button ('=')\"\"\"\n        try:\n            expression = self._elem_1['text']\n            # Evaluate the mathematical expression safely\n            result = eval(expression)\n            self._elem_1.configure(text=str(result))\n        except Exception:\n            self._elem_1.configure(text=\"Error\")\n\n\nif __name__ == '__main__':\n    root = tk.Tk()\n    app = MainApplication(root)\n    root.mainloop()"}